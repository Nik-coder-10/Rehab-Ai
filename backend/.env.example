# Copy this file to backend/.env and adjust values.
# NEVER commit the real .env file.

REHABAI_ENVIRONMENT=development
REHABAI_DEBUG=true
REHABAI_LOG_LEVEL=INFO

# Generate a real secret for anything beyond local development, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
REHABAI_SECRET_KEY=change-me-generate-a-long-random-string

# Local docker-compose PostgreSQL (see docker-compose.yml at repo root)
REHABAI_DATABASE_URL=postgresql+psycopg://rehabai:rehabai_dev@localhost:5432/rehabai

# Minutes until the JWT access token expires
REHABAI_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# JSON list of allowed browser origins
REHABAI_CORS_ORIGINS=["http://localhost:5173"]
